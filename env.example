# Copy this file to .env (which is gitignored) and fill in the real values.
# The same two values are exposed to the browser via GET /config.js (see server.js):
# the Supabase anon key is public by design and safe to ship, it only grants what RLS allows.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
PORT=3001
